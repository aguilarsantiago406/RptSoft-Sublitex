# =============================================================================
# SIPES — Variables de Entorno de Ejemplo (Backend)
# Copia este archivo como .env y completa los valores según tu entorno local.
# =============================================================================

# Puerto donde correrá el servidor NestJS
PORT=3000

# Entorno de ejecución: development | production | test
NODE_ENV=development

# =============================================================================
# CONEXIÓN A BASE DE DATOS (PostgreSQL)
# Formato: postgresql://[USUARIO]:[PASSWORD]@[HOST]:[PUERTO]/[DATABASE]?schema=[SCHEMA]
# =============================================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sipes_db?schema=public"

# Configuración de CORS (orígenes permitidos, separados por comas)
CORS_ORIGIN="*"
