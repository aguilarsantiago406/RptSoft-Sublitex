# =============================================================================
# SIPES - Variables de Entorno de Ejemplo (Backend)
# Copia este archivo como .env y completa los valores segun tu entorno local.
# =============================================================================

# Puerto donde correra el servidor NestJS
PORT=3001

# Entorno de ejecucion: development | production | test
NODE_ENV=development

# =============================================================================
# CONEXION A BASE DE DATOS (PostgreSQL)
# Formato: postgresql://[USUARIO]:[PASSWORD]@[HOST]:[PUERTO]/[DATABASE]?schema=[SCHEMA]
# =============================================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sipes_db?schema=public"

# =============================================================================
# AUTENTICACION JWT
# Cambia este valor por una cadena larga y aleatoria en produccion.
# =============================================================================
JWT_SECRET=sublitex-dev-secret-change-in-production

# Configuracion de CORS (origenes permitidos, separados por comas)
CORS_ORIGIN="*"

# =============================================================================
# SUPABASE STORAGE (Almacenamiento de Imagenes, Mockups y Archivos)
# Obtén estos valores desde el panel de Supabase: Settings -> API y Storage
# =============================================================================
SUPABASE_URL="https://tu-proyecto.supabase.co"
# Puedes usar la service_role key (recomendada para backend) o anon key
SUPABASE_KEY="tu-clave-service-role-o-anon"
# Nombre del bucket en Supabase Storage (por defecto: sublitex-archivos)
SUPABASE_BUCKET="sublitex-archivos"
# URL publica base del frontend para enlaces WhatsApp
FRONTEND_URL="https://app.sublitex.com"

